# Copy this file to .env.local and fill in the values.
# Without them the request form still works, but requests are only printed
# to the server log instead of being emailed to you.

# API key from https://resend.com (free tier is enough to start)
RESEND_API_KEY=
# Where new trip requests are sent (comma-separate several addresses)
INQUIRY_TO_EMAIL=
# Sender shown on the email; must be a domain verified in Resend.
# Leave empty to use Resend's test sender while setting up.
INQUIRY_FROM_EMAIL=
